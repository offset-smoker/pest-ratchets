* text=auto eol=lf

# Fixtures are read for their exact lines; never let git rewrite them.
/tests/Fixtures/** -text

# Development-only paths are left out of the dist archive Composer installs.
/.github            export-ignore
/docs               export-ignore
/tests              export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/pint.json          export-ignore
